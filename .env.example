# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# URL pública (Vercel). En local puedes omitirla.
APP_URL="https://build-program1.vercel.app"

# SUPABASE INTEGRATION (cloud):
# Copy these into .env.local and replace with your project values from supabase.com → Settings → API
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"

# Servidor (no exponer en el navegador)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
SESSION_SECRET="cambia-este-texto-largo-minimo-16"
ADMIN_EMAIL="ruth.cerna@gmail.com"
ADMIN_PASSWORD="123456"
CONTACT_TO_EMAIL="nydo.mallas@gmail.com"
QUOTE_COPY_EMAIL="nydo.mallas@gmail.com"
FORMSUBMIT_COMPANY_ID="6312175e06725a0677d2696caf1892c6"
RESEND_API_KEY="re_xxxxxxxx"
# Con onboarding@resend.dev Resend solo entrega a tu propio correo.
# Verifica el dominio en resend.com/domains y usa un from de ese dominio:
MAIL_FROM="Nydo Mallas <onboarding@resend.dev>"
